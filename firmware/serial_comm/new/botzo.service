[Unit]
Description=Botzo Controller
After=bluetooth.target bluetooth.service multi-user.target
Wants=bluetooth.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/ros2_ws/src/botzo/firmware/serial_comm/new
ExecStart=/bin/bash /ros2_ws/src/botzo/firmware/serial_comm/new/start_bot.sh
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target


